    ],
    "path": "mods/live-guard-gate",
    "footprint": {
      "env_reads": [],
      "file_writes": [],
      "spawns": [],
      "egress_hosts": []
    }
  },
  {
    "id": "secret-redactor",
    "name": "Secret Redactor",
    "version": "1.0.0",
    "description": "Asks before tool calls whose input carries a credential and redacts credentials from tool output.",
    "reach_level": 0,
    "events": [
      "PreToolUse",
      "PostToolUse"
    ],
    "harnesses": [
      "claude-code",
      "codex",
      "kiro"
    ],
    "path": "mods/secret-redactor",
    "footprint": {
      "env_reads": [
        "VANGUARD_SECRET_REDACTOR_PATTERNS"
      ],
      "file_writes": [],
      "spawns": [],
      "egress_hosts": []
    }
  }
]
