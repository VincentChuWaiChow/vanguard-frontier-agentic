{
  "provider": "atlassian",
  "domains": {
    "incident-prevention": {
      "keywords": [
        "incident",
        "postmortem",
        "post-incident",
        "corrective action",
        "recurrence",
        "recurring",
        "root cause",
        "problem management",
        "preventive"
      ],
      "agent": "atlassian-incident-prevention-agent"
    },
    "control-evidence-lineage": {
      "keywords": [
        "audit",
        "control objective",
        "control evidence",
        "evidence chain",
        "compliance evidence",
        "sox",
        "iso 27001",
        "attestation",
        "control owner",
        "evidence package"
      ],
      "agent": "atlassian-control-evidence-lineage-agent"
    },
    "knowledge-integrity": {
      "keywords": [
        "stale",
        "outdated",
        "out of date",
        "contradictory",
        "contradiction",
        "contradicts",
        "ownerless",
        "no owner",
        "documentation drift",
        "knowledge base",
        "decision record",
        "adr",
        "superseded"
      ],
      "agent": "atlassian-knowledge-integrity-agent"
    },
    "ai-cost": {
      "keywords": [
        "rovo credits",
        "ai cost",
        "token cost",
        "cost per outcome",
        "llm spend"
      ],
      "agent": "finops-ai-economist-agent"
    }
  },
  "live_guards": [
    "atlassian-live-write-guard-agent"
  ],
  "gate_mode": "live-guard-gate",
  "live_guard_intent": "\\b(create|file|raise|update|edit|transition|move|archive|restore|publish|close|resolve|delete|approve|decline|restrict|unrestrict|bulk[- ]?(?:edit|update|close))\\b[^.]{0,80}\\b(jira|confluence|jsm|service desk)\\b",
  "parallel_threshold": 0.6
}
